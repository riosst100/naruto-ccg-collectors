# Copy to .env (repo root). Both apps and the Prisma CLI read this single file.

# SQLite for development. Relative paths resolve from the repo root.
# For PostgreSQL later: change `provider` in schema.prisma and use a postgresql:// URL.
DATABASE_URL="file:./data/dev.db"

# Where uploaded images are stored (LocalStorage driver). Shared by both apps. Relative to repo root.
UPLOAD_DIR="./uploads"
STORAGE_DRIVER="local"

# Seed credentials (development ONLY). In production set strong values or create the admin manually.
SEED_ADMIN_EMAIL="admin@naruto-ccg.local"
SEED_ADMIN_PASSWORD="Admin#12345"
SEED_USER_EMAIL="user@naruto-ccg.local"
SEED_USER_PASSWORD="User#12345"
